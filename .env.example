IKUAI_ADDR=http://192.168.1.1
IKUAI_TOKEN=replace-with-your-4.x-api-token
HTTP_TIMEOUT=10s
HTTP_READ_RETRIES=2
HTTP_INSECURE_SKIP_VERIFY=false
TZ=Asia/Shanghai
IKUAI_EXPORTER_LISTEN_ADDR=0.0.0.0:8000
IKUAI_EXPORTER_DISABLE=false
IKUAI_COLLECT_IPV6=true
IKUAI_SCRAPE_TIMEOUT=15s
IKUAI_JOB_TIMEOUT=5m
IKUAI_CRON_SKIP_START=false

# Optional 4.x tasks. Keep JSON on a single line, enclosed in single quotes.
# IKUAI_IP_OBJECT_1='{"schedule":"8h","name":"China","urls":["https://raw.githubusercontent.com/Hackl0us/GeoIP2-CN/release/CN-ip-cidr.txt"],"comment":"ikuai-aio"}'
# IKUAI_DOMAIN_RULE_1='{"schedule":"10m","name":"GFW","interface":"wan2","urls":["https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/gfw.txt"],"source":["192.168.1.10-192.168.1.20"],"priority":31,"comment":"ikuai-aio"}'
